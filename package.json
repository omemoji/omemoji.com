{
  "name": "omemoji.com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/dev.ts",
    "generate:schema": "bun run scripts/gen-schema.ts && biome check --fix content/artworks/_schema.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --fix .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --fix .",
    "check:ci": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expressive-code/plugin-collapsible-sections": "0.44.1",
    "@expressive-code/plugin-line-numbers": "0.44.1",
    "budoux": "0.8.4",
    "cheerio": "1.2.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "katex": "0.18.1",
    "mdast-util-to-hast": "13.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "7.1.0",
    "rehype-expressive-code": "0.44.1",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "rehype-unwrap-images": "1.0.0",
    "remark-denden-ruby": "0.3.1",
    "remark-frontmatter": "5.0.0",
    "remark-gemoji": "8.0.0",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "satori": "0.29.0",
    "sharp": "0.35.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.0",
    "zod": "4.4.3",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "^1.3.14",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
